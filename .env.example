# ============================================================
# sinegu-api environment secrets — EXAMPLE
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---------- App / environment ----------
APP_ENV=production
FRONTEND_BASE_URL=https://yourdomain.com
API_BASE_URL=https://api.yourdomain.com
FRONTEND_BASE_URL_DEV=http://localhost:8080
API_BASE_URL_DEV=http://localhost/sinegu-api
API_BASE_URL_COINSBUY_DEV=

# ---------- MySQL ----------
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=sinegu_db

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SECRET_KEY_TEST=sk_test_xxx
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_xxx
STRIPE_WEBHOOK_SECRET_TEST=whsec_xxx

# ---------- Coinsbuy ----------
COINSBUY_API_KEY=
COINSBUY_API_SECRET=
COINSBUY_WEBHOOK_SECRET=
COINSBUY_BASE_URL=https://v3.api.coinsbuy.com
COINSBUY_USD_WALLET_ID=
COINSBUY_API_KEY_SANDBOX=
COINSBUY_API_SECRET_SANDBOX=
COINSBUY_WEBHOOK_SECRET_SANDBOX=
COINSBUY_BASE_URL_SANDBOX=https://v3.api-sandbox.coinsbuy.com
COINSBUY_USD_WALLET_ID_SANDBOX=

# ---------- SMTP ----------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_ENCRYPTION=tls

# ---------- Capital.com Flask bot listener ----------
BOT_LISTENER_URL=http://localhost:5001
BOT_LISTENER_SECRET=
DISABLE_ACCOUNT_SECRET=
CAPITAL_API_LOG_SECRET=

# ---------- IG.com Flask bot listener ----------
IG_BOT_LISTENER_URL=http://localhost:6001
IG_BOT_LISTENER_SECRET=
IG_DISABLE_ACCOUNT_SECRET=
IG_API_LOG_SECRET=

# Billing cron listener — shared secret the Telegram bot presents (X-Billing-Secret).
# When set, cron/run_monthly_billing.php and cron/mark_overdue_and_disconnect.php require it
# for HTTP calls (CLI is always allowed). Must match the bot's BILLING_CRON_SECRET.
BILLING_CRON_SECRET=
# Optional: base URL this API uses to call its own endpoints (default http://localhost/sinegu-api).
# SELF_API_BASE=http://localhost/sinegu-api

# ---------- Combined Master (TEMPORARY, prod/167 only) ----------
# Splices a banned legacy account's pre-cutoff history onto the current master
# account's post-cutoff history for the public Bot Performance chart.
# Set COMBINED_MASTER=on ONLY on prod (167). Leave off on staging/local.
# Restore plain single-account logic by setting COMBINED_MASTER=off when Elias returns.
COMBINED_MASTER=off
COMBINED_MASTER_LEGACY_ID=1
COMBINED_MASTER_CURRENT_ID=2
COMBINED_MASTER_CUTOFF=2026-01-01
COMBINED_MASTER_CURRENCY=USD
# Hosts where the splice is ALWAYS refused (even if the flag is on) — comma-separated
# substrings matched against the request host. Default blocks staging (182/nexastaging);
# the retired andrea/156 names are kept so an old .env or old host stays blocked too.
COMBINED_MASTER_BLOCK_HOSTS=nexastaging,191.218.162.182,andrea-orcelinvest,156.67.30.81
