# ============================================================
# sinegu-api environment secrets — EXAMPLE
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---------- App / environment ----------
APP_ENV=production
FRONTEND_BASE_URL=https://yourdomain.com
API_BASE_URL=https://api.yourdomain.com
FRONTEND_BASE_URL_DEV=http://localhost:8080
API_BASE_URL_DEV=http://localhost/sinegu-api
API_BASE_URL_COINSBUY_DEV=

# ---------- MySQL ----------
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=sinegu_db

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SECRET_KEY_TEST=sk_test_xxx
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_xxx
STRIPE_WEBHOOK_SECRET_TEST=whsec_xxx

# ---------- Coinsbuy ----------
COINSBUY_API_KEY=
COINSBUY_API_SECRET=
COINSBUY_WEBHOOK_SECRET=
COINSBUY_BASE_URL=https://v3.api.coinsbuy.com
COINSBUY_USD_WALLET_ID=
COINSBUY_API_KEY_SANDBOX=
COINSBUY_API_SECRET_SANDBOX=
COINSBUY_WEBHOOK_SECRET_SANDBOX=
